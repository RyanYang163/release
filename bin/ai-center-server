#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""AI Center - TOS 7 Deb backend for a WebUI Internal Open (iframe) app.

The TOS platform proxy talks to this process over a Unix domain socket:

    socket    /var/api/ryan-ai-center.sock   (mode 0660)
    proxy     /v2/proxy/ryan-ai-center/...   -> forwarded to this server
    doc root  /usr/local/ryan-ai-center/     (webui.bz2, unpacked by postinst)

The application has no backend API: it serves a static frontend whose only
external dependencies are the AI sites the user clicks through to. There is
therefore no authentication layer here, and none is required - every byte
served is public, non-privileged content, and the platform proxy is the
authentication boundary for reaching the socket at all. Consequently the
Cookie / X-Csrf-Token header scheme from the development guide is not used,
because the frontend never issues a request to this process.

Standard library only. TOS 7 ships Python 3.10, and the TOS review standards
forbid lifecycle scripts from installing packages at runtime.
"""

import errno
import json
import os
import posixpath
import signal
import socket
import sys
import threading
import time
import urllib.parse
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# ---------------------------------------------------------------------------
# Configuration (overridable through EnvironmentFile, see ryan-ai-center.env)
# ---------------------------------------------------------------------------

APP_ID = os.environ.get("APP_ID", "ryan-ai-center")
SOCKET_PATH = os.environ.get("SOCKET_PATH", "/var/api/{}.sock".format(APP_ID))
SOCKET_MODE = int(os.environ.get("SOCKET_MODE", "0660"), 8)
DOC_ROOT = os.environ.get("DOC_ROOT", "/usr/local/{}".format(APP_ID))
LOG_LEVEL = os.environ.get("LOG_LEVEL", "INFO").upper()

# AF_UNIX is the transport on TOS (Linux). Platforms without it, such as
# Windows, cannot run this server; that is reported clearly at startup rather
# than failing with an AttributeError at import time.
AF_UNIX = getattr(socket, "AF_UNIX", None)

IDLE_TIMEOUT = 30      # seconds a keep-alive connection may stay idle
LISTEN_BACKLOG = 128   # >= 100 concurrent connections, per the socket spec

# Request paths reach this process through the platform proxy, so the
# application prefix may or may not still be present. Longest match first.
_PROXY_PREFIXES = (
    "/v2/proxy/{}".format(APP_ID),
    "/{}".format(APP_ID),
)

# Nothing under these paths is ever served. config.ini and the .lang file are
# platform metadata, bin/ and init.d/ hold the executable, and the rest are
# packaging inputs that must not leak to the browser.
_DENIED_NAMES = frozenset({"config.ini", "webui.bz2", "md5sums", "control"})
_DENIED_SUFFIXES = (".lang", ".env", ".sh")
_DENIED_DIRS = frozenset({"bin", "init.d", "DEBIAN", "depends", "nginx", "build", "webui"})

_MIME_TYPES = {
    ".html": "text/html; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".js": "application/javascript; charset=utf-8",
    ".mjs": "application/javascript; charset=utf-8",
    ".json": "application/json; charset=utf-8",
    ".svg": "image/svg+xml",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".webp": "image/webp",
    ".avif": "image/avif",
    ".ico": "image/x-icon",
    ".woff": "font/woff",
    ".woff2": "font/woff2",
    ".ttf": "font/ttf",
    ".otf": "font/otf",
    ".map": "application/json; charset=utf-8",
    ".txt": "text/plain; charset=utf-8",
    ".md": "text/plain; charset=utf-8",
    ".xml": "application/xml; charset=utf-8",
}


# ---------------------------------------------------------------------------
# Logging - [YYYY-MM-DD HH:MM:SS] [LEVEL] [component] message on stdout,
# captured by systemd/journald (the TOS-preferred destination for app logs).
# ---------------------------------------------------------------------------

_LEVELS = {"DEBUG": 10, "INFO": 20, "WARN": 30, "ERROR": 40}
_LOG_LOCK = threading.Lock()


def log(level, component, message):
    if _LEVELS.get(level, 20) < _LEVELS.get(LOG_LEVEL, 20):
        return
    line = "[{}] [{}] [{}] {}".format(
        time.strftime("%Y-%m-%d %H:%M:%S"), level, component, message
    )
    with _LOG_LOCK:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def read_app_version():
    """Version comes from config.ini so there is a single source of truth."""
    try:
        with open(os.path.join(DOC_ROOT, "config.ini"), "r", encoding="utf-8") as handle:
            return json.load(handle).get("version", "unknown")
    except (OSError, ValueError):
        return "unknown"


def current_user():
    try:
        import pwd
        return pwd.getpwuid(os.geteuid()).pw_name
    except Exception:
        return str(os.geteuid())


APP_VERSION = read_app_version()


# ---------------------------------------------------------------------------
# URL -> file resolution
# ---------------------------------------------------------------------------

def strip_proxy_prefix(url_path):
    """Drop the platform proxy prefix, if present, from a request path."""
    for prefix in _PROXY_PREFIXES:
        if url_path == prefix:
            return "/"
        if url_path.startswith(prefix + "/"):
            return url_path[len(prefix):]
    return url_path


def resolve(url_path):
    """Resolve a request path to a readable file inside DOC_ROOT.

    Returns (absolute_path, HTTPStatus.OK) or (None, error_status).
    """
    decoded = urllib.parse.unquote(url_path)
    normalised = posixpath.normpath("/" + decoded.lstrip("/"))
    parts = [part for part in normalised.split("/") if part and part != "."]

    # Reject traversal, hidden files and packaging internals before touching
    # the filesystem.
    for part in parts:
        if part.startswith(".") or part in _DENIED_DIRS:
            return None, HTTPStatus.FORBIDDEN
    if parts:
        name = parts[-1]
        if name in _DENIED_NAMES or name.endswith(_DENIED_SUFFIXES):
            return None, HTTPStatus.FORBIDDEN

    root = os.path.realpath(DOC_ROOT)
    full = os.path.realpath(os.path.join(root, *parts)) if parts else root

    # Follow symlinks only within DOC_ROOT.
    if full != root and not full.startswith(root + os.sep):
        return None, HTTPStatus.FORBIDDEN

    if os.path.isdir(full):
        index = os.path.join(full, "index.html")
        if os.path.isfile(index):
            return index, HTTPStatus.OK
        return None, HTTPStatus.NOT_FOUND

    if not os.path.isfile(full):
        return None, HTTPStatus.NOT_FOUND

    return full, HTTPStatus.OK


def content_type_for(path):
    return _MIME_TYPES.get(os.path.splitext(path)[1].lower(), "application/octet-stream")


# ---------------------------------------------------------------------------
# HTTP handler
# ---------------------------------------------------------------------------

class RequestHandler(BaseHTTPRequestHandler):
    server_version = "AiCenter"
    sys_version = ""
    protocol_version = "HTTP/1.1"   # enables keep-alive
    timeout = IDLE_TIMEOUT          # idle connections are dropped after 30s

    # --- logging routed through the application logger ---
    def log_message(self, fmt, *args):
        log("DEBUG", "http", "%s %s - %s" % (self.command, self.path, fmt % args))

    def log_error(self, fmt, *args):
        log("WARN", "http", fmt % args)

    # --- responses ---
    def send_body(self, status, body=b"", ctype="text/plain; charset=utf-8", extra=None):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if self.command != "HEAD" and body:
            self.wfile.write(body)

    def send_error_page(self, status):
        try:
            phrase = HTTPStatus(status).phrase
        except ValueError:
            phrase = "Error"
        body = (
            '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">'
            "<title>{code} {phrase}</title></head>"
            '<body style="font-family:system-ui,-apple-system,sans-serif;'
            'background:#0a0a0f;color:#e0e0e0;padding:4rem 2rem">'
            "<h1 style=\"font-size:1.5rem\">{code} {phrase}</h1>"
            "<p style=\"color:#888\">The requested resource is not available.</p>"
            "</body></html>"
        ).format(code=int(status), phrase=phrase).encode("utf-8")
        self.send_body(status, body, "text/html; charset=utf-8")

    def send_cors_headers(self):
        origin = self.headers.get("Origin", "")
        if origin:
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Vary", "Origin")
        self.send_header("Access-Control-Allow-Methods", "GET, HEAD, OPTIONS")
        self.send_header("Access-Control-Allow-Headers",
                         "Content-Type, X-Csrf-Token, Cookie")
        self.send_header("Access-Control-Allow-Credentials", "true")

    # --- CORS preflight, used by the platform proxy ---
    def do_OPTIONS(self):
        self.send_response(HTTPStatus.NO_CONTENT)
        self.send_header("Content-Length", "0")
        self.send_cors_headers()
        self.end_headers()

    def do_GET(self):
        self.serve(head_only=False)

    def do_HEAD(self):
        self.serve(head_only=True)

    def _method_not_allowed(self):
        self.send_response(HTTPStatus.METHOD_NOT_ALLOWED)
        self.send_header("Allow", "GET, HEAD, OPTIONS")
        self.send_header("Content-Length", "0")
        self.end_headers()

    do_POST = do_PUT = do_DELETE = do_PATCH = _method_not_allowed

    def serve(self, head_only=False):
        path = strip_proxy_prefix(urllib.parse.urlsplit(self.path).path)

        # Liveness probe. Reachable as /health, /ryan-ai-center/health and
        # /v2/proxy/ryan-ai-center/health.
        if path in ("/health", "/healthz"):
            payload = json.dumps({
                "status": "ok",
                "app": APP_ID,
                "version": APP_VERSION,
            }).encode("utf-8")
            self.send_body(HTTPStatus.OK, payload, "application/json; charset=utf-8")
            return

        if path in ("", "/"):
            path = "/index.html"

        target, status = resolve(path)
        if target is None:
            if status == HTTPStatus.NOT_FOUND:
                log("DEBUG", "http", "404 %s" % self.path)
            else:
                log("WARN", "http", "%s %s" % (int(status), self.path))
            self.send_error_page(status)
            return

        try:
            with open(target, "rb") as handle:
                body = handle.read()
        except OSError as exc:
            log("ERROR", "http", "cannot read %s: %s" % (target, exc))
            self.send_error_page(HTTPStatus.INTERNAL_SERVER_ERROR)
            return

        self.send_body(HTTPStatus.OK, body, content_type_for(target),
                       extra={"Cache-Control": "no-cache"})


# ---------------------------------------------------------------------------
# HTTP server bound to a Unix domain socket
# ---------------------------------------------------------------------------

class UnixSocketHTTPServer(ThreadingHTTPServer):
    address_family = AF_UNIX
    daemon_threads = True
    allow_reuse_address = False
    request_queue_size = LISTEN_BACKLOG

    def server_bind(self):
        # Bind without BaseHTTPServer's getfqdn() call: it is meaningless for a
        # Unix socket and can block on a DNS lookup.
        self.socket.bind(self.server_address)
        self.server_name = "localhost"
        self.server_port = 0

    def server_activate(self):
        self.socket.listen(self.request_queue_size)

    def get_request(self):
        request, _ = self.socket.accept()
        return request, ("localhost", 0)


# ---------------------------------------------------------------------------
# Startup / shutdown
# ---------------------------------------------------------------------------

_SHUTDOWN = threading.Event()


def handle_signal(signum, _frame):
    log("INFO", "main", "received signal %d, shutting down" % signum)
    _SHUTDOWN.set()


def watch_for_shutdown(server):
    # serve_forever() runs on the main thread, so shutdown() has to be called
    # from another thread or it would deadlock.
    _SHUTDOWN.wait()
    threading.Thread(target=server.shutdown, daemon=True).start()


def prepare_socket_path():
    directory = os.path.dirname(SOCKET_PATH)
    if not os.path.isdir(directory):
        try:
            os.makedirs(directory, exist_ok=True)
            log("INFO", "main", "created socket directory %s" % directory)
        except OSError as exc:
            log("ERROR", "main", "cannot create %s: %s" % (directory, exc))
            return False

    # A socket file left behind by a previous run makes bind() fail with
    # EADDRINUSE, so remove it before binding.
    if os.path.lexists(SOCKET_PATH):
        try:
            os.unlink(SOCKET_PATH)
            log("INFO", "main", "removed stale socket %s" % SOCKET_PATH)
        except OSError as exc:
            log("ERROR", "main", "cannot remove stale socket %s: %s" % (SOCKET_PATH, exc))
            return False
    return True


def main():
    log("INFO", "main", "AI Center %s starting as %s" % (APP_VERSION, current_user()))

    if AF_UNIX is None:
        log("ERROR", "main", "this Python build has no AF_UNIX support; the TOS "
                             "WebUI internal-open socket transport requires Linux")
        return 1

    if not os.path.isdir(DOC_ROOT):
        log("ERROR", "main", "document root %s does not exist" % DOC_ROOT)
        log("ERROR", "main", "postinst unpacks webui.bz2 there; reinstall the package")
        return 1

    if not prepare_socket_path():
        return 1

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    try:
        server = UnixSocketHTTPServer(SOCKET_PATH, RequestHandler)
    except OSError as exc:
        log("ERROR", "main", "cannot bind %s: %s" % (SOCKET_PATH, exc))
        if exc.errno in (errno.EACCES, errno.EPERM, errno.EROFS):
            directory = os.path.dirname(SOCKET_PATH)
            log("ERROR", "main", "%s cannot write to %s" % (current_user(), directory))
            log("ERROR", "main", "remedy: sudo setfacl -m u:%s:rwx %s"
                % (current_user(), directory))
        return 1

    # The platform proxy must be able to connect to the socket: mode 0660,
    # owned by the service user and group.
    try:
        os.chmod(SOCKET_PATH, SOCKET_MODE)
    except OSError as exc:
        log("WARN", "main", "cannot chmod %s: %s" % (SOCKET_PATH, exc))

    try:
        import pwd
        entry = pwd.getpwnam(APP_ID)
        os.chown(SOCKET_PATH, entry.pw_uid, entry.pw_gid)
    except (ImportError, KeyError, OSError):
        pass

    log("INFO", "main", "listening on %s (mode %04o), serving %s"
        % (SOCKET_PATH, SOCKET_MODE, DOC_ROOT))
    log("INFO", "main", "log level %s" % LOG_LEVEL)

    threading.Thread(target=watch_for_shutdown, args=(server,), daemon=True).start()

    try:
        # poll_interval keeps the loop responsive to the signal handler.
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        try:
            if os.path.lexists(SOCKET_PATH):
                os.unlink(SOCKET_PATH)
        except OSError:
            pass
        log("INFO", "main", "stopped")

    return 0


if __name__ == "__main__":
    sys.exit(main())
