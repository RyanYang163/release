[Unit]
Description=AI Center - AI tools and software testing resources portal
Documentation=https://github.com/RyanYang163/AI-Center
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
# User= only — do NOT add Group=.
# The TOS platform creates the application user with the pre-existing
# "allusers" group as its primary group; it does not create a group named
# after the application. systemd resolves Group= at start time, so
# `Group=ryan-ai-center` fails with status 216/GROUP and the service never
# starts, even though the user exists. Omitting Group= makes systemd use the
# user's primary group (allusers). Verified on a TNAS running TOS 7.
User=ryan-ai-center
WorkingDirectory=/usr/local/ryan-ai-center
ExecStart=/usr/local/ryan-ai-center/bin/ai-center-server
EnvironmentFile=/usr/local/ryan-ai-center/ryan-ai-center.env
TimeoutStartSec=30
TimeoutStopSec=10

# --- Required hardening (TOS 7 review standard, section 12.7) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

# Only application-owned paths are writable; ProtectSystem=strict makes
# everything else read-only.
#   /var/lib/ryan-ai-center  runtime state
#   /var/api                 only used by the iframe fallback - i.e. when the
#                            environment file sets SOCKET_PATH. Listing it is
#                            harmless while unused, and required when it is:
#                            without it the socket bind fails with EROFS.
# This package runs in WebUI External Open mode (a TCP port + nginx), so
# /var/api is normally untouched.
ReadWritePaths=/var/api /var/lib/ryan-ai-center

# --- Recommended hardening ---
# PrivateTmp= is deliberately NOT set.
# On TOS /var/api is a symlink to /tmp/api, and this application must bind
# /var/api/ryan-ai-center.sock there. PrivateTmp= mounts a fresh empty tmpfs
# over /tmp, so that socket path resolves inside a private namespace that
# contains no "api" entry: systemd then fails with status 226/NAMESPACE
# ("Failed to set up mount namespacing: .../tmp/api: No such file or
# directory"). Even if the namespace came up, the socket would be created in
# the private tmpfs and stay invisible to the platform proxy.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

# --- Resource limits (TOS web-service profile: 1 core / 512 MB) ---
LimitNOFILE=65536
LimitNPROC=256
MemoryMax=512M
CPUQuota=100%

# --- Restart policy (executed by the App Center) ---
Restart=on-failure
RestartSec=10

# Note: AmbientCapabilities=CAP_NET_BIND_SERVICE is intentionally absent.
# This application binds no TCP port at all; it serves exclusively over the
# Unix socket at /var/api/ryan-ai-center.sock.

[Install]
WantedBy=multi-user.target
