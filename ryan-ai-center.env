# AI Center — environment configuration
# Loaded by systemd via EnvironmentFile=/usr/local/ryan-ai-center/ryan-ai-center.env
# Change a value, then: sudo systemctl restart ryan-ai-center
#
# This file is installed with mode 0644 and contains no secrets.

# Application identity (also used in log lines)
APP_ID=ryan-ai-center

# ---------------------------------------------------------------------------
# WebUI External Open (new browser tab) — the current mode.
# The backend listens on this port and the platform's nginx proxies
# /ryan-ai-center/ to it, so the application opens in a new browser tab.
#
# Port rules from the development guide:
#   - must bind 0.0.0.0, never 127.0.0.1, or the NAS is unreachable from the LAN
#   - must not use the reserved ports 22, 80, 443, 8181, 5050
#   - recommended range 8000-19999
# 18788 was verified free on the test device (only 8181 and 9222 were taken).
# ---------------------------------------------------------------------------
LISTEN_PORT=18788
LISTEN_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# WebUI Internal Open (iframe) — NOT used in this mode, kept as a fallback.
# Set to /var/api/ryan-ai-center.sock to additionally serve the platform proxy
# over a Unix socket, which is what iframe mode needs. Leave empty otherwise.
# Switching modes also means changing config.ini (type/open_path) and removing
# nginx/ — see the README.
# ---------------------------------------------------------------------------
SOCKET_PATH=

# Directory holding the frontend extracted from webui.bz2.
DOC_ROOT=/usr/local/ryan-ai-center

# Log level: ERROR | WARN | INFO | DEBUG
# INFO  = lifecycle events only (recommended for production)
# DEBUG = adds one line per HTTP request; production use is discouraged
LOG_LEVEL=INFO

# Never write .pyc files: the package tree is mounted read-only (ProtectSystem=strict)
PYTHONDONTWRITEBYTECODE=1

# Unbuffered stdout so systemd/journald receives log lines immediately
PYTHONUNBUFFERED=1
